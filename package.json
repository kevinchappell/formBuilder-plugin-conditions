{
  "name": "formbuilder-plugin-conditions",
  "version": "0.0.0-development",
  "description": "Conditional visibility plugin for formBuilder and formRender: show a field when another field matches a rule.",
  "license": "MIT",
  "author": "Kevin Chappell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinchappell/formBuilder-plugin-conditions.git"
  },
  "homepage": "https://kevinchappell.github.io/formBuilder-plugin-conditions/",
  "bugs": {
    "url": "https://github.com/kevinchappell/formBuilder-plugin-conditions/issues"
  },
  "keywords": [
    "formBuilder",
    "formRender",
    "form",
    "conditional",
    "visibility",
    "plugin",
    "jquery"
  ],
  "type": "module",
  "main": "dist/formbuilder-plugin-conditions.umd.js",
  "module": "dist/formbuilder-plugin-conditions.js",
  "unpkg": "dist/formbuilder-plugin-conditions.umd.js",
  "jsdelivr": "dist/formbuilder-plugin-conditions.umd.js",
  "exports": {
    ".": {
      "import": "./dist/formbuilder-plugin-conditions.js",
      "require": "./dist/formbuilder-plugin-conditions.umd.js",
      "default": "./dist/formbuilder-plugin-conditions.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "prepare": "husky",
    "prepack": "npm run build",
    "release": "semantic-release"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "formBuilder": "^3.23.1",
    "jquery": ">=3.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "formBuilder": "^3.23.1",
    "formbuilder-languages": "^1.2.1",
    "husky": "^9.1.7",
    "jquery": "^3.7.1",
    "jsdom": "^29.1.1",
    "mi18n": "^0.4.8",
    "semantic-release": "^25.0.9",
    "storage-available": "^1.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
